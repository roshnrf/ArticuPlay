# Copy to .env and fill in real values. Never commit .env.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for SQLAlchemy/Alembic
# Supabase dashboard: Project Settings > Database > Connection string (URI, use the "Session pooler" or direct connection)
# Format: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# Gemini API key (https://aistudio.google.com/apikey) — free tier, used for parent tips
GEMINI_API_KEY=

# faster-whisper model size: tiny | base | small | medium | large-v3
# base is the minimum viable per Week 1 spike (tiny hallucinates on child speech)
WHISPER_MODEL_SIZE=base

# Auth
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma-separated origins allowed to call the API, parsed as a list
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
